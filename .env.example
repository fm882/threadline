# Copy to .env; never commit .env. Requires Node >=22 for these helper scripts.
# Optional: select your existing AWS CLI profile. No credentials are copied.
# AWS_PROFILE=default
AWS_REGION_NAME=us-east-1

# Routes are deployment-independent aliases in the app, Bedrock routes here.
BEDROCK_MAIN_ROUTE=bedrock/converse/us.amazon.nova-pro-v1:0
BEDROCK_FAST_ROUTE=bedrock/converse/us.amazon.nova-micro-v1:0
# Claude candidates require working Marketplace/payment access in this account:
# BEDROCK_MAIN_ROUTE=bedrock/converse/us.anthropic.claude-sonnet-4-6
# BEDROCK_FAST_ROUTE=bedrock/converse/us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_ROUTE=bedrock/amazon.titan-embed-text-v2:0
BEDROCK_RERANK_ROUTE=bedrock/arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0

LITELLM_PORT=4000
# Optional custom executable path (default: litellm in PATH).
# LITELLM_BIN=litellm
# Local launcher generates .data/litellm.key when this is absent.
# LITELLM_MASTER_KEY=

INFERENCE_BASE_URL=http://127.0.0.1:4000/v1
# Verifier uses the local key file if this is absent. Set for a remote gateway.
# INFERENCE_API_KEY=
CHAT_MAIN_MODEL=chat-main-v1
CHAT_FAST_MODEL=chat-fast-v1
EMBEDDING_MODEL=history-embedding-v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SPACE_ID=titan-v2-1024-v1
RERANK_URL=http://127.0.0.1:4000/rerank
RERANK_MODEL=history-rerank-v1

# Local application settings (optional defaults shown).
# PORT=3000
# APP_DATA_DIR=.data
OPERATIONAL_EVENT_RETENTION_DAYS=30
EMBEDDING_MODEL=history-embedding-v1
EMBEDDING_SPACE_ID=titan-v2-1024-v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_NORMALIZED=true
# Titan Text Embeddings V2 uses the same text input mode for queries and documents.
EMBEDDING_QUERY_INPUT_MODE=shared
EMBEDDING_DOCUMENT_INPUT_MODE=shared
RERANK_MODEL=history-rerank-v1
# RERANK_URL defaults to /rerank on INFERENCE_BASE_URL's host.
# RERANK_API_KEY= only needed for a separately hosted remote rerank endpoint.
# MODEL_CAPABILITIES_PATH=config/model-capabilities.json
# A chatFallback manifest entry requires verified fast streaming and research-contract checks,
# the exact BEDROCK_FAST_ROUTE identity, tool-call/prompted-JSON support, and a lower context cap.

# Application integrations.
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=minmi-local
