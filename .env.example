# Copy to .env and replace provider-specific values. Never commit .env.
# Requires Node.js >=22; this template does not select a model provider.

# Chat and embeddings share this OpenAI-compatible API base and credential.
INFERENCE_BASE_URL=https://your-provider.example/v1
INFERENCE_API_KEY=
CHAT_MAIN_MODEL=your-chat-model-id

# Optional separate chat fallback. Uncomment and configure only if the matching
# verified chatFallback is enabled in config/model-capabilities.json.
# CHAT_FAST_MODEL=your-fallback-model-id

# Embeddings for semantic history retrieval. Match dimensions and normalization
# to the model. Use a new immutable space ID when changing vector spaces.
EMBEDDING_MODEL=your-embedding-model-id
EMBEDDING_SPACE_ID=your-embedding-model-dimensions-v1
# Replace the sample dimension and normalization setting to match your model.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_NORMALIZED=true
EMBEDDING_QUERY_INPUT_MODE=shared
EMBEDDING_DOCUMENT_INPUT_MODE=shared

# Optional reranker endpoint. If omitted, the app tries /rerank on the inference host.
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=your-reranker-model-id

# Live web search. Without this key, current-source research is unavailable.
TAVILY_API_KEY=

# Optional local application settings.
# PORT=3000
# APP_DATA_DIR=.data
OPERATIONAL_EVENT_RETENTION_DAYS=30
# MODEL_CAPABILITIES_PATH=config/model-capabilities.json

# Optional LangSmith tracing. Disabled unless explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=threadline-local

# Optional local LiteLLM launcher settings. Provider-specific keys and routes
# belong in .env only when the selected LiteLLM config requires them.
# LITELLM_PORT=4000
# LITELLM_BIN=litellm
# LITELLM_MASTER_KEY=
